# VYNR recognition server. Copy to .env (never commit it) or set these in your host's secret store.

# Required. Create a key at https://platform.claude.com/ and set a workspace spend limit there too.
ANTHROPIC_API_KEY=

# Models (defaults shown). Every model must have a price in src/pricing.ts or the server refuses to start.
# RECOGNITION_MODEL=claude-haiku-5-5
# Second opinion for uncertain or ambiguous answers. "off" disables escalation.
# RECOGNITION_ESCALATION_MODEL=claude-sonnet-5-5
# ESCALATE_BELOW_CONFIDENCE=0.7
# MAX_OUTPUT_TOKENS=1024
# ESCALATION_MAX_OUTPUT_TOKENS=3000

# Image limits. The app sends ~1024 px JPEGs; anything larger is downscaled before the model call.
# MAX_IMAGE_BYTES=1000000
# MAX_IMAGE_EDGE=1280

# Persistent rate limits (survive restarts; stored in STATE_FILE).
# RATE_PER_INSTALL_PER_MINUTE=6
# RATE_PER_INSTALL_PER_DAY=25
# RATE_PER_IP_PER_MINUTE=20
# RATE_PER_IP_PER_DAY=300

# Global spend protection. Each call reserves its worst-case cost before it starts,
# so concurrent requests can never overshoot these ceilings. 0 disables recognition.
# GLOBAL_DAILY_REQUEST_BUDGET=2000
# DAILY_SPEND_LIMIT_USD=2
# MONTHLY_SPEND_LIMIT_USD=50

# Identical photos within this window return the cached answer at no cost.
# RESULT_CACHE_SECONDS=86400

# SQLite file holding quotas, spend and the result cache. Put it on a persistent volume.
# STATE_FILE=./data/vynr-state.sqlite

# MAX_CONCURRENT_UPSTREAM=8
# Keep below the app's 25 s client timeout.
# UPSTREAM_TIMEOUT_MS=20000
# PORT=8787
# HOST=0.0.0.0
# Set to 1 only when running behind a reverse proxy that appends X-Forwarded-For.
# TRUST_PROXY=0

# ── Economy (accounts, VYNR Credits, collectibles, market) ──
# ECONOMY_STATE_FILE=./data/vynr-economy.sqlite
# Comma-separated feature flags. "subscriptions" stays off until Apple and Google
# credentials are configured; without them every purchase request is refused.
# FEATURES=economy,crates,marketplace,seasons,social
# ACCOUNTS_PER_IP_PER_DAY=5
# ECONOMY_WRITES_PER_MINUTE=60
# RATE_PER_INSTALL_PER_DAY_BLACK=40
