# VYNR recognition server. Copy to .env (never commit it) or set these in your host's secret store.

# Required. Create a key at https://platform.claude.com/ and set a monthly spend limit there too.
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown).
# RECOGNITION_MODEL=claude-opus-5-5
# PORT=8787
# HOST=0.0.0.0
# MAX_IMAGE_BYTES=1500000
# MAX_IMAGE_EDGE=1600
# RATE_PER_INSTALL_PER_MINUTE=6
# RATE_PER_INSTALL_PER_DAY=50
# RATE_PER_IP_PER_MINUTE=20
# RATE_PER_IP_PER_DAY=300
# Hard ceiling on AI calls per UTC day across all users. 0 disables recognition.
# GLOBAL_DAILY_REQUEST_BUDGET=2000
# MAX_CONCURRENT_UPSTREAM=8
# Keep below the app's 25 s client timeout.
# UPSTREAM_TIMEOUT_MS=20000
# Set to 1 only when running behind a reverse proxy that appends X-Forwarded-For.
# TRUST_PROXY=0
