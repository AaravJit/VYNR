# VYNR app build configuration. EXPO_PUBLIC_* values are compiled into the app
# and are PUBLIC: never put secrets here. AI credentials live only on the server
# (see server/.env.example).

# Recognition mode: "remote" (real identification via the VYNR server) or "mock"
# (simulated, clearly labelled). Leave unset to use the defaults:
#   development builds -> mock, release builds -> manual identification only.
EXPO_PUBLIC_RECOGNITION_MODE=

# Base URL of the recognition server, e.g. https://vynr-recognition.example.com
# Release builds require https. Setting this alone selects "remote" mode.
EXPO_PUBLIC_RECOGNITION_ENDPOINT=
